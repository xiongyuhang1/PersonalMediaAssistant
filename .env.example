# Only for the root SQLite development prototype, not the Sites production app.
# Sites production settings are documented in docs/Sites配置.md.
# Generate private local keys with npm run bootstrap; do not paste keys in chat.
PMA_HOST=127.0.0.1
PMA_PORT=4318
PMA_DATABASE=data/personal-media.sqlite
PMA_SERVICE_TOKEN=
PMA_COLLECTOR_TOKEN=
PMA_COLLECTOR_DEVICE_ID=windows-primary
PMA_CURSOR_SECRET=

# Optional read-only platform access. Secrets belong on the backend only.
STEAM_API_KEY=
STEAM_ID=
BILIBILI_COOKIE=
NETEASE_API_URL=http://netease:3000
NETEASE_COOKIE=
NETEASE_UID=
