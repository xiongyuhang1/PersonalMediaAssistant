{
  "name": "personal-media-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/src/main.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "bootstrap": "node scripts/bootstrap.mjs",
    "package:delivery": "python scripts/package-delivery.py"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.13.2",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
